# Keep the build context small and deterministic: the image builds its index
# from data/corpus, never from a developer's generated index or usage log.
.git
.gitignore
.venv
venv
__pycache__/
*.py[cod]
.pytest_cache/
.ruff_cache/
*.egg-info/
build/
dist/

data/index.json
data/index.sqlite3
data/index.sqlite3-*
data/collections/
data/uploads/
data/usage.db
data/usage.db-*
data/rate-limit.db
data/rate-limit.db-*
data/*.tmp

frontend/node_modules/
frontend/dist/

tests/
scripts/
docs/
.env
.env.*
